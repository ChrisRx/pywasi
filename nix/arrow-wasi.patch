diff --git a/cpp/cmake_modules/ThirdpartyToolchain.cmake b/cpp/cmake_modules/ThirdpartyToolchain.cmake
index e8bd9dd..400d5f9 100644
--- a/cpp/cmake_modules/ThirdpartyToolchain.cmake
+++ b/cpp/cmake_modules/ThirdpartyToolchain.cmake
@@ -1785,10 +1785,18 @@ function(build_thrift)
   if(CMAKE_VERSION VERSION_LESS 3.26)
     message(FATAL_ERROR "Require CMake 3.26 or later for building bundled Apache Thrift")
   endif()
+  # WASI has no sockets: leave out the transports and servers using them,
+  # which Parquet doesn't need.
+  set(THRIFT_PATCH_COMMAND)
+  if(CMAKE_SYSTEM_NAME STREQUAL "WASI")
+    set(THRIFT_PATCH_COMMAND PATCH_COMMAND ${CMAKE_COMMAND} -P
+                             "${CMAKE_CURRENT_LIST_DIR}/thrift-wasi.cmake")
+  endif()
   fetchcontent_declare(thrift
                        ${FC_DECLARE_COMMON_OPTIONS}
                        URL ${THRIFT_SOURCE_URL}
-                       URL_HASH "SHA256=${ARROW_THRIFT_BUILD_SHA256_CHECKSUM}")
+                       URL_HASH "SHA256=${ARROW_THRIFT_BUILD_SHA256_CHECKSUM}"
+                       ${THRIFT_PATCH_COMMAND})
 
   prepare_fetchcontent()
   set(BUILD_COMPILER OFF)
diff --git a/cpp/cmake_modules/thrift-wasi.cmake b/cpp/cmake_modules/thrift-wasi.cmake
new file mode 100644
index 0000000..432ac11
--- /dev/null
+++ b/cpp/cmake_modules/thrift-wasi.cmake
@@ -0,0 +1,7 @@
+# Drops Apache Thrift's socket-based transports and servers from its C++
+# library, for WASI, which has no sockets. Run in Thrift's source directory.
+file(READ lib/cpp/CMakeLists.txt content)
+string(REGEX REPLACE
+       "[ \t]*src/thrift/(transport/(THttp[A-Za-z]*|TSocket[A-Za-z]*|TServerSocket|SocketCommon|TPipe[A-Za-z]*|TFileTransport)|server/[A-Za-z]*)\\.cpp\n"
+       "" content "${content}")
+file(WRITE lib/cpp/CMakeLists.txt "${content}")
