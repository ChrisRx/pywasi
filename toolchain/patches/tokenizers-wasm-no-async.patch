tokenizers: leave the async methods out on wasm.

async_encode, async_encode_batch(_fast) and async_decode_batch run on a
multi-threaded tokio runtime, which tokio doesn't build for wasm (no
threads). The rest of the API is synchronous and unaffected.

--- a/bindings/python/Cargo.toml
+++ b/bindings/python/Cargo.toml
@@ -16,8 +16,6 @@
 libc = "0.2"
 env_logger = "0.11"
 pyo3 = { version = "=0.29", default-features = false, features = ["py-clone", "experimental-inspect"] }
-pyo3-async-runtimes = { version = "0.29", features = ["tokio-runtime"] }
-tokio = { version = "1.47.1", features = ["rt", "rt-multi-thread", "macros", "signal"] }
 once_cell = "1.19.0"
 numpy = "0.29"
 ndarray = "0.16"
@@ -25,6 +23,11 @@
 ahash = { version = "0.8.11", features = ["serde"] }
 pyo3-ffi = { version = "=0.29" }
 
+# The async methods: not on wasm, which has no threads for tokio's runtime.
+[target.'cfg(not(target_family = "wasm"))'.dependencies]
+pyo3-async-runtimes = { version = "0.29", features = ["tokio-runtime"] }
+tokio = { version = "1.47.1", features = ["rt", "rt-multi-thread", "macros", "signal"] }
+
 [dependencies.tokenizers]
 path = "../../tokenizers"
 
