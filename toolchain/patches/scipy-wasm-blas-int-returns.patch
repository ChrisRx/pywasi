+        # pywasi: f2py calls subroutines through void function pointers, but
+        # OpenBLAS's C LAPACK defines them as int functions, and wasm calls
+        # must match signatures exactly.
+        if os.environ.get("_PYTHON_HOST_PLATFORM", "").startswith("wasi"):
+            for fname in os.listdir(outdir_abs):
+                if fname.endswith("module.c"):
+                    path = os.path.join(outdir_abs, fname)
+                    with open(path) as fp:
+                        code = fp.read()
+                    code = code.replace("void (*f2py_func)(", "int (*f2py_func)(")
+                    code = re.sub(r"\bextern void (F_FUNC(?:_US)?)\(", r"extern int \1(", code)
+                    with open(path, "w") as fp:
+                        fp.write(code)
