safetensors: build and load files on WASI.

Positional reads have no std API on wasip1, so seek and read (there are
no threads to share the cursor with). memmap2 can't map files on WASI,
which safe_open does, so numpy's load_file reads the file and
deserializes it instead.

--- a/bindings/python/src/lib.rs
+++ b/bindings/python/src/lib.rs
@@ -1943,6 +1943,14 @@
         use std::os::unix::fs::FileExt;
         file.read_exact_at(buf, offset)
     }
+    #[cfg(target_os = "wasi")]
+    {
+        // No threads (wasip1), so moving the file's shared cursor is safe.
+        use std::io::{Read, Seek, SeekFrom};
+        let mut f = file;
+        f.seek(SeekFrom::Start(offset))?;
+        f.read_exact(buf)
+    }
