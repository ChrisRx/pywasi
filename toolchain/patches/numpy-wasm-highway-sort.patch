numpy: Highway's vectorized quicksort on wasm.

numpy's CPU dispatch has no wasm targets, so np.sort fell back to its
scalar quicksort. Call Highway's VQSortStatic (WASM SIMD128 target)
directly for 32- and 64-bit keys, ascending and descending. Highway's
seed uses clock(), which WASI lacks, so use clock_gettime there. Used by
toolchain/recipes.toml.

--- a/numpy/_core/meson.build
+++ b/numpy/_core/meson.build
@@ -1259,6 +1259,7 @@
   'src/npysort/timsort_generic.cpp',
   'src/npysort/heapsort.cpp',
   'src/npysort/npysort_methods.cpp',
+  'src/npysort/highway_qsort_wasm.cpp',
   'src/common/npy_partition.h',
   'src/npysort/selection.cpp',
   'src/common/npy_binsearch.h',
--- a/numpy/_core/src/highway/hwy/contrib/sort/vqsort-inl.h
+++ b/numpy/_core/src/highway/hwy/contrib/sort/vqsort-inl.h
@@ -64,7 +64,14 @@
   void (*seed_code)(void*) = &Fill16BytesStatic;
   const uintptr_t bits_stack = reinterpret_cast<uintptr_t>(seed_stack);
   const uintptr_t bits_code = reinterpret_cast<uintptr_t>(seed_code);
+#if HWY_ARCH_WASM
+  // pywasi: WASI has no process clock (clock() isn't linkable).
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  const uint64_t bits_time = static_cast<uint64_t>(ts.tv_nsec);
+#else
   const uint64_t bits_time = static_cast<uint64_t>(clock());
+#endif
   words[0] = bits_stack ^ bits_time ^ 0xFEDCBA98;  // "Nothing up my sleeve"
   words[1] = bits_code ^ bits_time ^ 0x01234567;   // constants.
 }
