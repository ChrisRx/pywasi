diff --color -ruN a/numpy/_core/src/npysort/highway_qsort_wasm.cpp b/numpy/_core/src/npysort/highway_qsort_wasm.cpp
--- a/numpy/_core/src/npysort/highway_qsort_wasm.cpp
+++ b/numpy/_core/src/npysort/highway_qsort_wasm.cpp
@@ -0,0 +1,151 @@
+/*
+ * pywasi: Highway's vectorized sort and select for wasm SIMD128, called
+ * directly since numpy's CPU dispatch has no wasm targets.
+ */
+#if defined(__wasm_simd128__)
+#define VQSORT_ONLY_STATIC 1
+#include "hwy/highway.h"
+#include "hwy/contrib/sort/vqsort-inl.h"
+
+#include "highway_qsort.hpp"
+
+#include <cmath>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+#include <type_traits>
+
+namespace np::highway::qsort_simd {
+/*
+ * Highway's float select can duplicate values when given infinities and
+ * NaNs, so floats are selected as integers: an order-preserving bijection
+ * maps them to keys and back. Flipping gives
+ * -NaN < -inf < ... < -0 < +0 < ... < +inf < +NaN;
+ * subtracting the mantissa mask then rotates the -NaN block to the top, so
+ * every NaN sorts last, as in numpy. Flipping the sign bit last makes the
+ * keys signed: wasm SIMD has no unsigned 64-bit compare, so Highway would
+ * emulate one and sort about 2x slower.
+ */
+template <typename T>
+struct FloatKeys {
+    using U = std::conditional_t<sizeof(T) == 4, uint32_t, uint64_t>;
+    using I = std::make_signed_t<U>;
+    static constexpr U kSign = U(1) << (sizeof(U) * 8 - 1);
+    static constexpr U kMant = (U(1) << (std::numeric_limits<T>::digits - 1)) - 1;
+
+    static I *Encode(T *arr, npy_intp size)
+    {
+        U *keys = reinterpret_cast<U *>(arr);
+        for (npy_intp i = 0; i < size; i++) {
+            U bits;
+            std::memcpy(&bits, &arr[i], sizeof(bits));
+            bits = (bits & kSign) ? ~bits : (bits | kSign);
+            keys[i] = (bits - kMant) ^ kSign;
+        }
+        return reinterpret_cast<I *>(arr);
+    }
+
+    static void Decode(I *ikeys, npy_intp size)
+    {
+        U *keys = reinterpret_cast<U *>(ikeys);
+        for (npy_intp i = 0; i < size; i++) {
+            U bits = (keys[i] ^ kSign) + kMant;
+            keys[i] = (bits & kSign) ? (bits & ~kSign) : ~bits;
+        }
+    }
+};
+
+template <typename T>
+void QSortWasm(T *arr, npy_intp size, bool reverse)
+{
+    if (reverse) {
+        hwy::HWY_NAMESPACE::VQSortStatic(arr, size, hwy::SortDescending());
+    }
+    else {
+        hwy::HWY_NAMESPACE::VQSortStatic(arr, size, hwy::SortAscending());
+    }
+}
+
+template <typename T>
+void QSelectWasm(T *arr, npy_intp size, npy_intp kth)
+{
+    if constexpr (std::is_floating_point_v<T>) {
+        auto *keys = FloatKeys<T>::Encode(arr, size);
+        hwy::HWY_NAMESPACE::VQSelectStatic(keys, size, kth, hwy::SortAscending());
+        FloatKeys<T>::Decode(keys, size);
+    }
+    else {
+        hwy::HWY_NAMESPACE::VQSelectStatic(arr, size, kth, hwy::SortAscending());
+    }
+}
+
+/*
+ * Map a key to an unsigned integer with the same order, NaNs last (as numpy
+ * sorts them).
+ */
+template <typename T, typename U>
+static inline U OrderedBits(T v)
+{
+    constexpr U sign = U(1) << (sizeof(U) * 8 - 1);
+    if constexpr (std::is_floating_point_v<T>) {
+        if (std::isnan(v)) {
+            return ~U(0);
+        }
+        U bits;
+        std::memcpy(&bits, &v, sizeof(bits));
+        return (bits & sign) ? ~bits : (bits | sign);
+    }
+    else if constexpr (std::is_signed_v<T>) {
+        return static_cast<U>(v) ^ sign;
+    }
+    else {
+        return static_cast<U>(v);
+    }
+}
+
+/*
+ * Argsort as a key-value sort: the key is the element (as OrderedBits) and
+ * the value is its index. npy_intp is 32 bits on wasm32, so indices fit
+ * either pair type. Returns false if the scratch buffer can't be allocated.
+ */
+template <typename T>
+bool ArgQSortWasm(T *arr, npy_intp *arg, npy_intp size)
+{
+    using KV = std::conditional_t<sizeof(T) == 4, hwy::K32V32, hwy::K64V64>;
+    using U = std::conditional_t<sizeof(T) == 4, uint32_t, uint64_t>;
+    static_assert(sizeof(npy_intp) <= sizeof(uint32_t), "wasm32 only");
+    KV *kv = static_cast<KV *>(std::aligned_alloc(alignof(KV), sizeof(KV) * (size_t)size));
+    if (kv == nullptr) {
+        return false;
+    }
+    for (npy_intp i = 0; i < size; i++) {
+        kv[i].key = OrderedBits<T, U>(arr[arg[i]]);
+        kv[i].value = static_cast<uint32_t>(arg[i]);
+    }
+    hwy::HWY_NAMESPACE::VQSortStatic(kv, size, hwy::SortAscending());
+    for (npy_intp i = 0; i < size; i++) {
+        arg[i] = static_cast<npy_intp>(kv[i].value);
+    }
+    std::free(kv);
+    return true;
+}
+
+#define PYWASI_INSTANTIATE(T) \
+    template void QSortWasm<T>(T *, npy_intp, bool); \
+    template void QSelectWasm<T>(T *, npy_intp, npy_intp);
+PYWASI_INSTANTIATE(int16_t)
+PYWASI_INSTANTIATE(uint16_t)
+PYWASI_INSTANTIATE(int32_t)
+PYWASI_INSTANTIATE(uint32_t)
+PYWASI_INSTANTIATE(int64_t)
+PYWASI_INSTANTIATE(uint64_t)
+PYWASI_INSTANTIATE(float)
+PYWASI_INSTANTIATE(double)
+#undef PYWASI_INSTANTIATE
+
+template bool ArgQSortWasm<int32_t>(int32_t *, npy_intp *, npy_intp);
+template bool ArgQSortWasm<uint32_t>(uint32_t *, npy_intp *, npy_intp);
+template bool ArgQSortWasm<float>(float *, npy_intp *, npy_intp);
+template bool ArgQSortWasm<double>(double *, npy_intp *, npy_intp);
+}  // namespace np::highway::qsort_simd
+#endif
