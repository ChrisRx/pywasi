@@ -0,0 +1,31 @@
+/*
+ * pywasi: Highway's vectorized quicksort for wasm SIMD128, called directly
+ * since numpy's CPU dispatch has no wasm targets.
+ */
+#if defined(__wasm_simd128__)
+#define VQSORT_ONLY_STATIC 1
+#include "hwy/highway.h"
+#include "hwy/contrib/sort/vqsort-inl.h"
+
+#include "highway_qsort.hpp"
+
+namespace np::highway::qsort_simd {
+template <typename T>
+void QSortWasm(T *arr, npy_intp size, bool reverse)
+{
+    if (reverse) {
+        hwy::HWY_NAMESPACE::VQSortStatic(arr, size, hwy::SortDescending());
+    }
+    else {
+        hwy::HWY_NAMESPACE::VQSortStatic(arr, size, hwy::SortAscending());
+    }
+}
+
+template void QSortWasm<int32_t>(int32_t *, npy_intp, bool);
+template void QSortWasm<uint32_t>(uint32_t *, npy_intp, bool);
+template void QSortWasm<int64_t>(int64_t *, npy_intp, bool);
+template void QSortWasm<uint64_t>(uint64_t *, npy_intp, bool);
+template void QSortWasm<float>(float *, npy_intp, bool);
+template void QSortWasm<double>(double *, npy_intp, bool);
+}  // namespace np::highway::qsort_simd
+#endif
